{
    "name": "@anorak-games/eslint-config",
    "version": "0.1.0",
    "type": "module",
    "description": "Shared ESLint flat-config for Anorak projects — one frontend factory (Expo client + Vite admin) and one backend config, so the convention rules live in a single place.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anorak-games/eslint-config-anorak.git"
    },
    "keywords": [
        "eslint",
        "eslintconfig",
        "eslint-config",
        "anorak"
    ],
    "files": [
        "backend.mjs",
        "frontend.mjs"
    ],
    "exports": {
        "./frontend": "./frontend.mjs",
        "./backend": "./backend.mjs"
    },
    "scripts": {
        "test": "node test/smoke.mjs"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-check-file": "^3.3.1",
        "eslint-plugin-prettier": "^5.2.0",
        "eslint-plugin-react": "^7.37.0",
        "prettier": "^3.4.0",
        "typescript-eslint": "^8.18.0"
    },
    "peerDependencies": {
        "eslint": "^9.18.0 || ^10.0.0",
        "typescript": "^5.7.0 || ^6.0.0"
    }
}
